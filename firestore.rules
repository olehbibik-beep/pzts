rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validIco(ico) {
      let sum = int(ico[0]) * 8 + int(ico[1]) * 7 + int(ico[2]) * 6 + int(ico[3]) * 5
        + int(ico[4]) * 4 + int(ico[5]) * 3 + int(ico[6]) * 2;
      return ico.matches('[0-9]{8}') && int(ico[7]) == (11 - sum % 11) % 10;
    }
    function company(uid) {
      let profile = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return owner(uid) && request.auth.token.email_verified == true
        && profile.accountType == 'company' && validIco(profile.ico);
    }
    function licensed(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      let license = get(/databases/$(database)/documents/cloudLicenses/$(uid)).data;
      return owner(uid) && request.auth.token.email_verified == true
        && profile.accountType == 'company' && license.status == 'active'
        && license.uid == uid && license.ico == profile.ico;
    }
    function validProfile() {
      let p = request.resource.data;
      return p.keys().hasOnly(['displayName', 'email', 'accountType', 'ico', 'locale', 'createdAt', 'updatedAt'])
        && p.keys().hasAll(['displayName', 'email', 'accountType', 'ico', 'locale', 'createdAt', 'updatedAt'])
        && p.displayName is string && p.displayName.size() > 0 && p.displayName.size() <= 120
        && p.email == request.auth.token.email && p.locale in ['cs', 'en']
        && ((p.accountType == 'personal' && p.ico == '') || (p.accountType == 'company' && validIco(p.ico)))
        && p.updatedAt == request.time;
    }
    function validLicense(uid) {
      let key = request.resource.data;
      return key.keys().hasAll(['uid', 'ico', 'status', 'keyHash', 'keySuffix', 'issuedAt', 'updatedAt'])
        && key.keys().hasOnly(['uid', 'ico', 'status', 'keyHash', 'keySuffix', 'issuedAt', 'updatedAt'])
        && key.uid == uid && key.status == 'active'
        && key.ico == getAfter(/databases/$(database)/documents/users/$(uid)).data.ico
        && key.keyHash is string && key.keyHash.matches('[a-f0-9]{64}')
        && key.keySuffix is string && key.keySuffix.matches('[A-F0-9]{8}')
        && key.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && validProfile() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validProfile() && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /cloudLicenses/{uid} {
      allow get: if owner(uid);
      allow create: if company(uid) && validLicense(uid) && request.resource.data.issuedAt == request.time;
      allow update: if company(uid) && validLicense(uid) && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['keyHash', 'keySuffix', 'updatedAt']);
      allow delete: if owner(uid);
    }
    match /users/{userId}/projects/{projectId} {
      allow read, write: if licensed(userId);
    }
  }
}
